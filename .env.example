# Browser-safe Supabase settings
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy name accepted by the code for older projects:
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase Edge Function / server-only secrets — NEVER prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Payments
FLW_SECRET_KEY=YOUR_FLUTTERWAVE_SECRET_KEY
FLW_SECRET_HASH=YOUR_FLUTTERWAVE_WEBHOOK_SECRET_HASH
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
INTERSWITCH_ACCESS_TOKEN=YOUR_INTERSWITCH_ACCESS_TOKEN
INTERSWITCH_MERCHANT_CODE=YOUR_INTERSWITCH_MERCHANT_CODE
INTERSWITCH_PAY_ITEM_ID=YOUR_INTERSWITCH_PAY_ITEM_ID

# AI routing
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
# Optional self-hosted/open-source gateway such as LiteLLM. The Academy can route to it without exposing the gateway to visitors.
AI_ROUTER_URL=
AI_ROUTER_SECRET=

# Email
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=Phenom Best Academy <no-reply@your-verified-domain.example>
