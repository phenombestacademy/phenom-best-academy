# Supabase connection for the Level 2 CMS.
# Add these values to Vercel Environment Variables and your local .env file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Level 3 platform
VITE_MODERATION_ENDPOINT=
# The following are server-side secrets and must NEVER be exposed as VITE_* values:
# FLW_SECRET_KEY=
# FLW_SECRET_HASH=
