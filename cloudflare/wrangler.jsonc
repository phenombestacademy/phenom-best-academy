{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "phenom-lms-background",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2
  },
  "vars": {
    "SUPABASE_URL": "https://hajrdejlamuiqjjhdnsv.supabase.co",
    "MIGRATION_MODE": "idle"
  },
  "queues": {
    "producers": [
      {
        "binding": "CONTENT_QUEUE",
        "queue": "phenom-lms-content"
      }
    ],
    "consumers": [
      {
        "queue": "phenom-lms-content",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 5,
        "dead_letter_queue": "phenom-lms-content-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "LMS_ASSETS",
      "bucket_name": "phenom-lms-assets"
    }
  ],
  "triggers": {
    "crons": []
  }
}
